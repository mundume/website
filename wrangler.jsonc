{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "apalis-website",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-05-05",
    "compatibility_flags": ["nodejs_compat"], // Required for next/og
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    }
  }
